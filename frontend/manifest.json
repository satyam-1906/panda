{
    "manifest_version": 3,
    "name": "Panda",
    "version": "1.0",
    "icons": {"16": "assets/panda.png"},
    "permissions": ["activeTab", "scripting"],
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["app.js"]
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": "assets/panda.png"
    }
}
